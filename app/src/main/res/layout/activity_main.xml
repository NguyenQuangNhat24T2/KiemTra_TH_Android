<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        <TextView
            android:id="@+id/tvThongTinSV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="W01A - Nguyễn Quang Nhật - 2415053122226"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilTenHP"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên học phần (1..40 ký tự)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtTenHP"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDiemQt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Điểm quá trình QT (0..10)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtDiemQt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilDiemCk"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Điểm cối kỳ CK (0..10)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtDiemCk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
        </com.google.android.material.textfield.TextInputLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnKiemTra"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Kiểm tra"
            <Button
                android:id="@+id/btnXoa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Xoá"
        </LinearLayout>
        <TextView
            android:id="@+id/tvKetQua"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
